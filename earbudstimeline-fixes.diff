+
+  const failed = results.filter((r) => r.status === 'rejected');
+  if (failed.length > 0) {
+    console.error(`uploadImage: ${failed.length}/${VARIANT_WIDTHS.length} variante(s) échouée(s) pour ${canonicalPath}`, failed[0].reason);
