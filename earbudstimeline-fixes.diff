+// stocker une variante "800" identique au canonique si celui-ci ne fait que
+// 500px de large.
+async function uploadVariants({ supabase, buffer, canonicalPath }) {
+  const results = await Promise.allSettled(
+    VARIANT_WIDTHS.map(async (width) => {
