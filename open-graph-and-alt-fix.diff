+export function ogDefaults(localizedPath, locale, type = 'website') {
+  const cleanPath = localizedPath.startsWith('/') ? localizedPath : `/${localizedPath}`;
+  return {
+    url: `${SITE_URL}${cleanPath}`,
+    type,
+    siteName: 'EarbudsTimeline',
+    locale: locale === 'fr' ? 'fr_FR' : 'en_US',
+  };
+}
